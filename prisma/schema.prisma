generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  FOUNDATION
  ADMIN
}

enum FoundationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum FoundationDocumentType {
  RUT
  LEGAL_EXISTENCE_CERTIFICATE
  LEGAL_REPRESENTATIVE_ID
  BANK_CERTIFICATION
}

enum SocialNetworkType {
  FACEBOOK
  INSTAGRAM
  X
  LINKEDIN
  YOUTUBE
  TIKTOK
  OTHER
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

enum NeedPriority {
  LOW
  MEDIUM
  HIGH
}

enum DonationStatus {
  COMMITTED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  DONATION_CREATED
  DONATION_STATUS_CHANGED
  DONATION_MESSAGE
  DONATION_DELIVERY_UPDATED
}

enum FoundationBranchStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
}

enum PostReactionType {
  LIKE
  LOVE
  PROUD
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  phone        String?
  city         String?
  department   String?
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  foundation Foundation?

  foundationObservations FoundationAdminObservation[] @relation("ObservationAuthor")
  verifiedFoundations    Foundation[]                 @relation("FoundationVerifier")
  donations              Donation[]                   @relation("DonationDonor")
  donationStatusChanges  DonationStatusHistory[]      @relation("DonationStatusChanger")
  messages               Message[]
  notifications          Notification[]
  stockMovementsCreated  StockMovement[] @relation("StockMovementCreator")
  inventoryOutboundsCreated InventoryOutbound[] @relation("OutboundCreator")
  postReactions          PostReaction[]
  postComments           PostComment[]

  @@map("users")
}

model Foundation {
  id                          String           @id @default(uuid()) @db.Uuid
  userId                      String           @unique @map("user_id") @db.Uuid
  name                        String
  acronym                     String?
  nit                         String?          @unique
  category                    String?
  mission                     String?
  vision                      String?
  description                 String?
  city                        String?
  department                  String?
  country                     String?
  address                     String?
  latitude                    Float?
  longitude                   Float?
  institutionalEmail          String?          @map("institutional_email")
  phone                       String?
  website                     String?
  legalRepresentativeName     String?          @map("legal_representative_name")
  legalRepresentativeDocument String?          @map("legal_representative_document")
  logoUrl                     String?          @map("logo_url")
  status                      FoundationStatus @default(PENDING)
  verifiedAt                  DateTime?        @map("verified_at")
  verifiedById                String?          @map("verified_by_id") @db.Uuid
  rejectedAt                  DateTime?        @map("rejected_at")
  suspendedAt                 DateTime?        @map("suspended_at")
  slug                        String?          @unique
  rejectionReason             String?          @map("rejection_reason")
  adminNotes                  String?          @map("admin_notes")
  deletedAt                   DateTime?        @map("deleted_at")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?                        @relation("FoundationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  socialLinks  FoundationSocialLink[]
  documents    FoundationDocument[]
  observations FoundationAdminObservation[]
  campaigns    Campaign[]
  branches     FoundationBranch[]
  inventoryItems    InventoryItem[]
  inventoryOutbounds InventoryOutbound[]
  foundationPosts   FoundationPost[]
  stockMovements    StockMovement[]

  @@index([status])
  @@index([category])
  @@index([city])
  @@index([department])
  @@map("foundations")
}

model FoundationSocialLink {
  id           String            @id @default(uuid()) @db.Uuid
  foundationId String            @map("foundation_id") @db.Uuid
  network      SocialNetworkType
  url          String
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  foundation Foundation @relation(fields: [foundationId], references: [id], onDelete: Cascade)

  @@unique([foundationId, network])
  @@map("foundation_social_links")
}

model FoundationDocument {
  id           String                 @id @default(uuid()) @db.Uuid
  foundationId String                 @map("foundation_id") @db.Uuid
  type         FoundationDocumentType
  fileUrl      String                 @map("file_url")
  fileName     String                 @map("file_name")
  mimeType     String                 @map("mime_type")
  fileSize     Int                    @map("file_size")
  uploadedAt   DateTime               @default(now()) @map("uploaded_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  foundation Foundation @relation(fields: [foundationId], references: [id], onDelete: Cascade)

  @@unique([foundationId, type])
  @@map("foundation_documents")
}

model FoundationAdminObservation {
  id           String   @id @default(uuid()) @db.Uuid
  foundationId String   @map("foundation_id") @db.Uuid
  authorId     String?  @map("author_id") @db.Uuid
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  foundation Foundation @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  author     User?      @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([foundationId, createdAt])
  @@map("foundation_admin_observations")
}

model FoundationBranch {
  id           String                 @id @default(uuid()) @db.Uuid
  foundationId String                 @map("foundation_id") @db.Uuid
  name         String
  department   String
  city         String
  address      String
  reference    String?
  phone        String
  openingHours String                 @map("opening_hours")
  latitude     Float?
  longitude    Float?
  status       FoundationBranchStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  foundation Foundation @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  donations  Donation[]
  inventoryOutbounds InventoryOutbound[]
  foundationPosts    FoundationPost[]
  stockMovements     StockMovement[]

  @@index([foundationId])
  @@index([foundationId, status])
  @@map("foundation_branches")
}

model Campaign {
  id                 String         @id @default(uuid()) @db.Uuid
  foundationId       String         @map("foundation_id") @db.Uuid
  foundationBranchId String         @map("foundation_branch_id") @db.Uuid
  title              String
  description        String
  imageUrl           String?        @map("image_url")
  status             CampaignStatus @default(DRAFT)
  startDate          DateTime?      @map("start_date")
  endDate            DateTime?      @map("end_date")
  deliveryAddress    String?        @map("delivery_address")
  deliveryLatitude   Float?         @map("delivery_latitude")
  deliveryLongitude  Float?         @map("delivery_longitude")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  foundation       Foundation       @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  foundationBranch FoundationBranch @relation(fields: [foundationBranchId], references: [id], onDelete: Restrict)
  needs            Need[]
  inventoryOutbounds InventoryOutbound[]
  foundationPosts    FoundationPost[]
  stockMovements     StockMovement[]

  @@index([foundationId])
  @@index([foundationBranchId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("campaigns")
}

model Need {
  id                String       @id @default(uuid()) @db.Uuid
  campaignId        String       @map("campaign_id") @db.Uuid
  name              String
  description       String?
  quantity          Int
  unit              String
  priority          NeedPriority @default(MEDIUM)
  fulfilledQuantity Int          @default(0) @map("fulfilled_quantity")
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@index([campaignId])
  @@index([priority])
  @@map("needs")
}

model Donation {
  id                  String         @id @default(uuid()) @db.Uuid
  needId              String         @map("need_id") @db.Uuid
  donorUserId         String         @map("donor_user_id") @db.Uuid
  foundationBranchId  String         @map("foundation_branch_id") @db.Uuid
  status              DonationStatus @default(COMMITTED)
  quantity            Int
  receivedQuantity    Int?           @map("received_quantity")
  notes               String?
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at")
  receivedAt          DateTime?      @map("received_at")
  receptionNotes      String?        @map("reception_notes")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  need             Need             @relation(fields: [needId], references: [id], onDelete: Cascade)
  donor            User             @relation("DonationDonor", fields: [donorUserId], references: [id], onDelete: Cascade)
  foundationBranch FoundationBranch @relation(fields: [foundationBranchId], references: [id], onDelete: Restrict)
  statusHistory    DonationStatusHistory[]
  conversation     Conversation?
  stockMovements   StockMovement[]

  @@index([needId])
  @@index([donorUserId])
  @@index([foundationBranchId])
  @@index([status])
  @@map("donations")
}

model DonationStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  donationId  String          @map("donation_id") @db.Uuid
  fromStatus  DonationStatus? @map("from_status")
  toStatus    DonationStatus  @map("to_status")
  changedById String?         @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  donation  Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("DonationStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([donationId, createdAt])
  @@map("donation_status_history")
}

model Conversation {
  id                    String    @id @default(uuid()) @db.Uuid
  donationId            String    @unique @map("donation_id") @db.Uuid
  lastMessageAt         DateTime? @map("last_message_at")
  lastMessageBody       String?   @map("last_message_body")
  lastMessageSenderId   String?   @map("last_message_sender_id") @db.Uuid
  donorLastReadAt       DateTime? @map("donor_last_read_at")
  foundationLastReadAt  DateTime? @map("foundation_last_read_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  donation Donation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  title        String
  body         String
  linkPath     String?          @map("link_path")
  resourceType String?          @map("resource_type")
  resourceId   String?          @map("resource_id") @db.Uuid
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  foundationId      String   @map("foundation_id") @db.Uuid
  name              String
  unit              String
  quantityAvailable Int      @default(0) @map("quantity_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  foundation  Foundation            @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  movements   StockMovement[]
  postLines   FoundationPostLine[]
  outboundLines InventoryOutboundLine[]

  @@index([foundationId])
  @@map("inventory_items")
}

model InventoryOutbound {
  id                     String   @id @default(uuid()) @db.Uuid
  foundationId           String   @map("foundation_id") @db.Uuid
  campaignId             String   @map("campaign_id") @db.Uuid
  foundationBranchId     String   @map("foundation_branch_id") @db.Uuid
  title                  String
  description            String
  observations           String?
  totalQuantityDelivered Int      @map("total_quantity_delivered")
  createdById            String?  @map("created_by_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")

  foundation       Foundation       @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  foundationBranch FoundationBranch @relation(fields: [foundationBranchId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("OutboundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines            InventoryOutboundLine[]
  movements        StockMovement[]
  post             FoundationPost?

  @@index([foundationId, createdAt])
  @@index([campaignId])
  @@index([foundationBranchId])
  @@map("inventory_outbounds")
}

model InventoryOutboundLine {
  id              String @id @default(uuid()) @db.Uuid
  outboundId      String @map("outbound_id") @db.Uuid
  inventoryItemId String @map("inventory_item_id") @db.Uuid
  quantity        Int

  outbound      InventoryOutbound @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([outboundId])
  @@map("inventory_outbound_lines")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  foundationId       String            @map("foundation_id") @db.Uuid
  inventoryItemId    String            @map("inventory_item_id") @db.Uuid
  donationId         String?           @map("donation_id") @db.Uuid
  campaignId         String?           @map("campaign_id") @db.Uuid
  foundationBranchId String?           @map("foundation_branch_id") @db.Uuid
  outboundId         String?           @map("outbound_id") @db.Uuid
  type               StockMovementType
  quantity           Int
  note               String?
  createdById        String?           @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")

  foundation       Foundation         @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  donation         Donation?          @relation(fields: [donationId], references: [id], onDelete: SetNull)
  campaign         Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  foundationBranch FoundationBranch?  @relation(fields: [foundationBranchId], references: [id], onDelete: SetNull)
  outbound         InventoryOutbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  createdBy        User?              @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([foundationId, createdAt])
  @@index([inventoryItemId])
  @@index([donationId])
  @@map("stock_movements")
}

model FoundationPost {
  id                     String   @id @default(uuid()) @db.Uuid
  foundationId           String   @map("foundation_id") @db.Uuid
  campaignId             String   @map("campaign_id") @db.Uuid
  foundationBranchId     String   @map("foundation_branch_id") @db.Uuid
  outboundId             String   @unique @map("outbound_id") @db.Uuid
  title                  String
  description            String
  totalQuantityDelivered Int      @map("total_quantity_delivered")
  slug                   String
  publishedAt            DateTime @default(now()) @map("published_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  foundation       Foundation           @relation(fields: [foundationId], references: [id], onDelete: Cascade)
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  foundationBranch FoundationBranch     @relation(fields: [foundationBranchId], references: [id], onDelete: Restrict)
  outbound         InventoryOutbound    @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  images           FoundationPostImage[]
  lines            FoundationPostLine[]
  reactions        PostReaction[]
  comments         PostComment[]

  @@unique([foundationId, slug])
  @@index([foundationId, publishedAt])
  @@index([foundationBranchId])
  @@map("foundation_posts")
}

model FoundationPostLine {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  itemName String @map("item_name")
  unit     String
  quantity Int

  post          FoundationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@map("foundation_post_lines")
}

model FoundationPostImage {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @map("post_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  post FoundationPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("foundation_post_images")
}

model PostReaction {
  id        String           @id @default(uuid()) @db.Uuid
  postId    String           @map("post_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      PostReactionType
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  post FoundationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_reactions")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post FoundationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}
